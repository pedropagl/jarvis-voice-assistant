# JARVIS - variaveis de ambiente (EXEMPLO)
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o .env real nem coloque chaves diretamente no codigo.

# Ambiente: desenvolvimento | producao
JARVIS_ENV=desenvolvimento

# Idioma das respostas
JARVIS_LANG=pt-BR

# ----- Provedor de LLM (prioridade: KILO > GEMINI > LOCAL) -----
# Sem nenhuma chave, a JARVIS roda em MODO LOCAL (interpretador deterministico).

# Opcao A: gateway Kilo AI (API compativel com OpenAI). Recomendado.
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
# Use modelos PAGOS (nao treinam com seus dados). NAO use modelos ":free".
# Modelos baratos e pagos: google/gemini-2.5-flash-lite | deepseek/deepseek-v4-flash:discounted
KILO_MODEL=google/gemini-2.5-flash-lite

# Opcao B: Gemini direto do Google (precisa de chave do Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ----- Voz (saida / Text-to-Speech) -----
# Motor: auto (neural com fallback offline) | edge (so neural) | pyttsx3 (so offline)
JARVIS_TTS_ENGINE=auto
# Voz neural: pt-BR-AntonioNeural | pt-BR-FranciscaNeural | pt-BR-ThalitaMultilingualNeural
JARVIS_TTS_VOICE=pt-BR-AntonioNeural
JARVIS_TTS_EDGE_RATE=+0%
JARVIS_TTS_RATE=180

# Painel da TV (usado a partir da Fase 11)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Nivel de log: INFO | DEBUG | WARNING
LOG_LEVEL=INFO
